{
  "name": "@hermes/telegram-interactions",
  "version": "0.1.0",
  "private": true,
  "description": "Local, typed Telegram interaction service with a Unix socket API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "grammy": "^1.38.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
