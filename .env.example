TELEGRAM_INTERACTIONS_BOT_TOKEN=replace-with-the-neutral-bot-token
TELEGRAM_INTERACTIONS_DATABASE_PATH=./runtime/interactions.db
TELEGRAM_INTERACTIONS_SOCKET_PATH=./runtime/service.sock
TELEGRAM_INTERACTIONS_DEFAULT_CHAT_ID=replace-with-private-chat-id
# Optional forum topic; leave blank for the main private chat.
TELEGRAM_INTERACTIONS_DEFAULT_THREAD_ID=
TELEGRAM_INTERACTIONS_DEFAULT_OPERATOR_USER_ID=replace-with-operator-user-id
# Optional; defaults to 300000 ms.
TELEGRAM_INTERACTIONS_RECONCILIATION_INTERVAL_MS=300000
# Optional; defaults to 1000 ms.
TELEGRAM_INTERACTIONS_DELIVERY_INTERVAL_MS=1000
