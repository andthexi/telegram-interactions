[Unit]
Description=Shared Hermes Telegram Interaction Service

[Service]
Type=simple
WorkingDirectory=%h/telegram-interactions
EnvironmentFile=-%h/telegram-interactions/.env
ExecStart=/home/hermes/.asdf/installs/nodejs/26.7.0/bin/node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
RuntimeDirectory=hermes-telegram-interactions
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
